# Copy this file to server/.env and put your own values in it.
# server/.env is in .gitignore, so your password never goes to GitHub.
# Without a .env file (or without MONGODB_URI), the server starts a temporary in-memory MongoDB.

# Your MongoDB connection string, for example from MongoDB Atlas (it must be a replica set; Atlas always is).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/

# Optional: the database name, used when the connection string does not name one. Default: scheme_kb
# MONGODB_DB=scheme_kb

# Optional: the port the server listens on. Default: 3000
# PORT=3000
